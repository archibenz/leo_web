# Spring Boot API — переменные окружения
# Скопируй в .env и заполни реальными значениями. .env в gitignore.
# Правило: если required-переменная (без default в application.yml) не установлена — приложение падает на старте.
# Проверить соответствие application.yml ↔ этот файл: scripts/check-env.sh --template

# === Database === (required)
# PostgreSQL (docker compose локально, managed в prod)
DB_URL=jdbc:postgresql://localhost:5432/reinasleo
DB_USER=reinasleo
DB_PASSWORD=

# === Auth === (required)
# Минимум 32 байта (256 бит). Генерировать: openssl rand -base64 48
JWT_SECRET=
# Общий секрет между Spring Boot и Python ботом для X-Bot-Secret header
BOT_API_SECRET=
# Required — TTL JWT в ms (24h = 86400000). Default убран: без явного значения сервис падает на старте.
JWT_EXPIRATION_MS=86400000

# === CORS === (required)
# Разрешённые origins через запятую, e.g. https://reinasleo.com,https://www.reinasleo.com
CORS_ORIGIN=

# === Email (Resend.com) === (required)
RESEND_API_KEY=
# From address. Example: REINASLEO <noreply@reinasleo.com>. Required — default убран чтобы prod не молча использовал неверный from.
RESEND_FROM=

# === Telegram === (required)
# Бот username из @BotFather (без @). Используется в deep-link URL. Required — default убран чтобы избежать deep-link на чужой bot если env забыли.
BOT_USERNAME=
# Bot token из @BotFather. Используется для sendMessage из TelegramNotifier
# (одноразовые коды удаления аккаунта). Required — без него падаем на старте.
TELEGRAM_BOT_TOKEN=

# === Uploads ===
# Опциональный override папки загрузок (default в yml: uploads)
UPLOAD_DIR=

# === Сброс кэша витрины в Next === (опционально, но на проде нужен)
# После публикации правки бэкенд дёргает ручку Next, та зовёт
# revalidateTag('storefront'). Без этой пары правка доезжает до покупателя не
# за минуту, а за ~15 (Caffeine 5 мин + max-age=60 + revalidate 600).
# ВНУТРЕННИЙ адрес процесса Next, не публичный домен: nginx проксирует весь
# /api/* в Spring Boot, и публичный https://reinasleo.com/api/revalidate уйдёт
# обратно в бэкенд. Правильно: http://127.0.0.1:3000/api/revalidate
WEB_REVALIDATE_URL=
# Общий секрет с apps/web (там та же переменная REVALIDATE_SECRET).
# Генерировать: openssl rand -base64 32
REVALIDATE_SECRET=

# === Metrics === (required)
# Shared secret для скрейпера Prometheus. Передаётся в header X-Metrics-Secret
# при GET /actuator/prometheus. Генерировать: openssl rand -base64 32
METRICS_SECRET=
